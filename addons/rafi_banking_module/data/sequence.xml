<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Bank Account -->
        <record id="seq_banking_account" model="ir.sequence">
            <field name="name">Bank Account</field>
            <field name="code">banking.account</field>
            <field name="prefix">BA</field>
            <field name="padding">6</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Sequence for Bank Transaction -->
        <record id="seq_banking_transaction" model="ir.sequence">
            <field name="name">Bank Transaction</field>
            <field name="code">banking.transaction</field>
            <field name="prefix">TRX</field>
            <field name="padding">8</field>
            <field name="number_increment">1</field>
        </record>
    </data>
</odoo>