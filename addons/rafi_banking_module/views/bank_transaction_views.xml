<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Bank Transaction Action -->
    <record id="action_banking_transaction" model="ir.actions.act_window">
        <field name="name">Bank Transactions</field>
        <field name="res_model">banking.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_done': 1}</field>
        <field name="target">current</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first transaction
            </p>
            <p>
                Click the create button to deposit, withdraw or transfer money.
            </p>
        </field>
    </record>

    <!-- Bank Transaction Views -->
    
    <!-- Bank Transaction list View -->
    <record id="view_banking_transaction_list" model="ir.ui.view">
        <field name="name">banking.transaction.list</field>
        <field name="model">banking.transaction</field>
        <field name="arch" type="xml">
            <list string="Bank Transactions" 
                  decoration-success="transaction_type=='deposit' or transaction_type=='transfer'"
                  decoration-danger="transaction_type=='withdraw' and state=='done'"
                  decoration-muted="state=='cancelled'">
                <field name="name"/>
                <field name="transaction_date"/>
                <field name="account_id"/>
                <field name="transaction_type"/>
                <field name="amount" sum="Total Amount"/>
                <field name="balance_after"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Bank Transaction Form View -->
    <record id="view_banking_transaction_form" model="ir.ui.view">
        <field name="name">banking.transaction.form</field>
        <field name="model">banking.transaction</field>
        <field name="arch" type="xml">
            <form string="Bank Transaction">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" 
                    invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_cancel" string="Cancel" type="object" 
                            invisible="state != 'draft'" confirm="Are you sure you want to cancel this transaction?"/>
                    <button name="action_set_draft" string="Set to Draft" type="object" 
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group name="transaction_details">
                            <field name="account_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="transaction_type" widget="radio"/>
                            <field name="amount" widget="monetary" 
                                   options="{'currency_field': 'account_id.currency_id'}"/>
                        </group>
                        <group name="transaction_info">
                            <field name="transaction_date"/>
                            <field name="balance_after" widget="monetary" 
                                   invisible="state == 'done'"
                                   options="{'currency_field': 'account_id.currency_id'}"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Add transaction notes..."/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Bank Transaction Search View -->
    <record id="view_banking_transaction_search" model="ir.ui.view">
        <field name="name">banking.transaction.search</field>
        <field name="model">banking.transaction</field>
        <field name="arch" type="xml">
            <search string="Search Transactions">
                <field name="name"/>
                <field name="account_id"/>
                <filter string="Deposits" name="deposits" domain="[('transaction_type','=','deposit')]"/>
                <filter string="Withdrawals" name="withdrawals" domain="[('transaction_type','=','withdraw')]"/>
                <filter string="Transfers" name="transfers" domain="[('transaction_type','=','transfer')]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Done" name="done" domain="[('state','=','done')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter string="Today" name="today" domain="[('transaction_date','=',context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="This Month" name="this_month" domain="[('transaction_date','&gt;=', (context_today()).strftime('%Y-%m-01'))]"/>
                <separator/>
                <filter string="Account" name="group_account" context="{'group_by':'account_id'}"/>
                <filter string="Type" name="group_type" context="{'group_by':'transaction_type'}"/>
                <filter string="State" name="group_state" context="{'group_by':'state'}"/>
                <filter string="Date" name="group_date" context="{'group_by':'transaction_date'}"/>
            </search>
        </field>
    </record>

    <menuitem id="menu_banking_transactions" name="Transactions" parent="menu_banking_root" 
              action="action_banking_transaction" sequence="20"/>
    
</odoo>