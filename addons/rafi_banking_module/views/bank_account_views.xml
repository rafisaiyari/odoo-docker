<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Bank Account Action -->

    <!-- Bank Account Action -->
    <record id="action_banking_account" model="ir.actions.act_window">
        <field name="name">Bank Accounts</field>
        <field name="res_model">banking.account</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first bank account
            </p>
            <p>
                Click the create button to set up a new bank account.
            </p>
        </field>
    </record>

    <!-- Bank Account Views -->

    <!-- Bank Account list View -->
    <record id="view_banking_account_list" model="ir.ui.view">
        <field name="name">banking.account.list</field>
        <field name="model">banking.account</field>
        <field name="arch" type="xml">
            <list string="Bank Accounts" decoration-success="state=='active'" 
                  decoration-muted="state=='closed'" decoration-warning="state=='suspended'">
                <field name="account_number"/>
                <field name="account_holder"/>
                <field name="account_type"/>
                <field name="balance" sum="Total Balance"/>
                <field name="currency_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Bank Account Form View -->
    <record id="view_banking_account_form" model="ir.ui.view">
        <field name="name">banking.account.form</field>
        <field name="model">banking.account</field>
        <field name="arch" type="xml">
            <form string="Bank Account">
                <header>
                    <button name="action_activate" string="Activate" type="object" 
                            invisible="state not in ('draft', 'suspended')" class="oe_highlight"/>
                    <button name="action_suspend" string="Suspend" type="object" 
                            invisible="state != 'active'" class="oe_highlight"/>
                    <button name="action_close" string="Close Account" type="object" 
                            invisible="state not in ('active', 'suspended')" 
                            confirm="Are you sure you want to close this account?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="account_number" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group name="account_details">
                            <field name="account_holder"/>
                            <field name="partner_id"/>
                            <field name="account_type"/>
                            <field name="currency_id"/>
                        </group>
                        <group name="balance_info">
                            <field name="balance" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="opening_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Transactions">
                            <field name="transaction_ids" readonly="1">
                                <list decoration-success="transaction_type=='deposit' or transaction_type=='transfer'"
                                      decoration-danger="transaction_type=='withdraw'">

                                    <field name="name"/>
                                    <field name="transaction_date"/>
                                    <field name="transaction_type"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="balance_after"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                
            </form>
        </field>
    </record>

    <!-- Bank Account Search View -->
    <record id="view_banking_account_search" model="ir.ui.view">
        <field name="name">banking.account.search</field>
        <field name="model">banking.account</field>
        <field name="arch" type="xml">
            <search string="Search Bank Accounts">
                <field name="account_number"/>
                <field name="account_holder"/>
                <field name="partner_id"/>
                <filter string="Active" name="active" domain="[('state','=','active')]"/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Suspended" name="suspended" domain="[('state','=','suspended')]"/>
                <filter string="Closed" name="closed" domain="[('state','=','closed')]"/>
                <separator/>
                <filter string="Account Type" name="group_type" context="{'group_by':'account_type'}"/>
                <filter string="State" name="group_state" context="{'group_by':'state'}"/>
            </search>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_banking_root" name="Banking" sequence="10"/>
    
    <menuitem id="menu_banking_accounts" name="Accounts" parent="menu_banking_root" 
              action="action_banking_account" sequence="10"/>


</odoo>